update_usage() {
    cat <<'EOF'
Usage: machstrap update|upgrade [--prefix PATH]

Fetch and fast-forward the main checkout containing this command from origin,
then reinstall it. This command is available only from a source checkout; an
installed self-contained runtime has no Git checkout to fetch from.

  --prefix PATH  Install updated Machstrap under PATH (default: $HOME/.local)
EOF
}

update_command() {
    local installer repository branch
    if (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; then
        update_usage
        return
    fi
    installer="$RUNTIME_ROOT/install.sh"
    if [[ ! -f "$installer" || -L "$installer" || ! -x "$installer" ]]; then
        err "update requires a source checkout; run ./install.sh --update from the checkout instead"
        return 1
    fi
    command_exists git || { err "update requires git"; return 1; }
    git -C "$RUNTIME_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
        err "update requires a Git checkout"
        return 1
    }
    repository="$(git -C "$RUNTIME_ROOT" rev-parse --show-toplevel)"
    repository="$(canonical_directory "$repository")" || return 1
    [[ "$repository" == "$RUNTIME_ROOT" ]] || {
        err "update must be run from the root of its Git checkout"
        return 1
    }
    branch="$(git -C "$RUNTIME_ROOT" symbolic-ref --quiet --short HEAD || true)"
    [[ "$branch" == main ]] || {
        err "update requires the checkout's main branch (current: ${branch:-detached HEAD})"
        return 1
    }
    git -C "$RUNTIME_ROOT" remote get-url origin >/dev/null 2>&1 || {
        err "update requires a configured origin remote"
        return 1
    }
    info "fetching main from origin"
    git -C "$RUNTIME_ROOT" fetch --quiet --no-tags origin main
    git -C "$RUNTIME_ROOT" merge-base --is-ancestor HEAD FETCH_HEAD || {
        err "origin/main cannot fast-forward the current checkout"
        return 1
    }
    git -C "$RUNTIME_ROOT" merge --quiet --ff-only FETCH_HEAD
    info "source updated to $(git -C "$RUNTIME_ROOT" rev-parse --short HEAD)"
    exec "$installer" --update "$@"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

version_command() {
    local version_file="$RUNTIME_ROOT/VERSION" version line_count
    [[ -f "$version_file" && ! -L "$version_file" ]] || {
        err "runtime version file is missing"
        return 1
    }
    line_count="$(awk 'END {print NR + 0}' "$version_file")"
    IFS= read -r version < "$version_file" || true
    [[ "$line_count" == 1 && "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
        err "runtime version file is invalid"
        return 1
    }
    printf 'machstrap %s\n' "$version"
}

canonical_file() {
    local path="$1" directory base
    [[ -f "$path" ]] || return 1
    directory="$(cd "$(dirname "$path")" && pwd -P)"
    base="$(basename "$path")"
    printf '%s/%s\n' "$directory" "$base"
}

canonical_directory() {
    local path="$1"
    [[ -d "$path" ]] || return 1
    (cd "$path" && pwd -P)
}

path_identity() {
    local path="$1"
    case "$(uname -s 2>/dev/null || printf unknown)" in
        Darwin|FreeBSD|OpenBSD|NetBSD)
            stat -f '%u %Lp' "$path" 2>/dev/null
            ;;
        *)
            stat -c '%u %a' "$path" 2>/dev/null
            ;;
    esac
}

config_locations() {
    local base
    if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        base="$XDG_CONFIG_HOME"
    elif [[ -n "${HOME:-}" ]]; then
        base="$HOME/.config"
    else
        return 1
    fi
    [[ "$base" == /* ]] || return 1
    MACHSTRAP_CONFIG_DIR="${base%/}/machstrap"
    MACHSTRAP_CONFIG_FILE="$MACHSTRAP_CONFIG_DIR/config"
}

secure_owned_config_path() {
    local path="$1" kind="$2" expected_mode="$3" identity uid mode
    [[ ! -L "$path" ]] || return 1
    if [[ "$kind" == directory ]]; then
        [[ -d "$path" ]] || return 1
    else
        [[ -f "$path" ]] || return 1
    fi
    identity="$(path_identity "$path")" || return 1
    uid="${identity%% *}"
    mode="${identity#* }"
    [[ "$uid" == "$(id -u)" && "$mode" == "$expected_mode" ]]
}

path_not_group_world_writable() {
    local path="$1" identity mode group_digit other_digit
    identity="$(path_identity "$path")" || return 1
    mode="${identity#* }"
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    group_digit="${mode: -2:1}"
    other_digit="${mode: -1}"
    [[ "$group_digit" != 2 && "$group_digit" != 3 &&
       "$group_digit" != 6 && "$group_digit" != 7 &&
       "$other_digit" != 2 && "$other_digit" != 3 &&
       "$other_digit" != 6 && "$other_digit" != 7 ]]
}

profile_root_safe() {
    local root="$1"
    [[ -d "$root" && ! -L "$root" && -r "$root" && -x "$root" ]] || return 1
    path_not_group_world_writable "$root"
}

profile_file_safe() {
    local file="$1"
    [[ -f "$file" && ! -L "$file" && -r "$file" ]] || return 1
    path_not_group_world_writable "$file"
}

profile_file_path() {
    local directory="$1" yml="$1/profile.yml" yaml="$1/profile.yaml"
    if [[ -e "$yml" || -L "$yml" ]] && [[ -e "$yaml" || -L "$yaml" ]]; then
        return 2
    fi
    if profile_file_safe "$yml"; then
        printf '%s\n' "$yml"
    elif profile_file_safe "$yaml"; then
        printf '%s\n' "$yaml"
    else
        return 1
    fi
}

load_configured_profile_root() {
    local root line_count canonical
    CONFIGURED_PROFILE_ROOT=""
    MACHSTRAP_CONFIG_STATE=missing
    config_locations || {
        MACHSTRAP_CONFIG_STATE=invalid
        warn "ignoring profile config: HOME/XDG_CONFIG_HOME does not resolve to an absolute path"
        return 2
    }
    [[ -e "$MACHSTRAP_CONFIG_FILE" || -L "$MACHSTRAP_CONFIG_FILE" ]] || return 1
    MACHSTRAP_CONFIG_STATE=invalid
    secure_owned_config_path "$MACHSTRAP_CONFIG_DIR" directory 700 || {
        warn "ignoring unsafe profile config directory: $MACHSTRAP_CONFIG_DIR"
        return 2
    }
    secure_owned_config_path "$MACHSTRAP_CONFIG_FILE" file 600 || {
        warn "ignoring unsafe profile config file: $MACHSTRAP_CONFIG_FILE"
        return 2
    }
    line_count="$(awk 'END {print NR + 0}' "$MACHSTRAP_CONFIG_FILE")"
    [[ "$line_count" == 1 ]] || {
        warn "ignoring malformed profile config: expected one path"
        return 2
    }
    IFS= read -r root < "$MACHSTRAP_CONFIG_FILE" || true
    [[ -n "$root" && "$root" == /* ]] || {
        warn "ignoring malformed profile config: path must be absolute"
        return 2
    }
    contains_control_characters "$root" && {
        warn "ignoring malformed profile config: path contains control characters"
        return 2
    }
    canonical="$(canonical_directory "$root")" || {
        warn "ignoring stale profile config: directory not found: $root"
        return 2
    }
    profile_root_safe "$canonical" || {
        warn "ignoring unsafe profile directory: $canonical"
        return 2
    }
    CONFIGURED_PROFILE_ROOT="$canonical"
    MACHSTRAP_CONFIG_STATE=loaded
}

configured_profile_candidate() {
    local name="$1" candidate profiles_root
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
    profiles_root="$(configured_collection_root profiles)" || return 1
    candidate="$profiles_root/$name"
    if [[ -e "$candidate" || -L "$candidate" ]]; then
        if profile_root_safe "$candidate" && profile_file_path "$candidate" >/dev/null; then
            printf '%s\n' "$candidate"
            return 0
        fi
        warn "ignoring unsafe configured profile: $candidate"
    fi
    return 1
}

configured_collection_root() {
    local collection="$1" root
    [[ "$collection" == profiles || "$collection" == inventories || "$collection" == identities ]] || return 2
    load_configured_profile_root >/dev/null || true
    [[ -n "$CONFIGURED_PROFILE_ROOT" ]] || return 1
    root="$CONFIGURED_PROFILE_ROOT/$collection"
    profile_root_safe "$root" || return 1
    printf '%s\n' "$root"
}

valid_collection_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

identity_file_safe() {
    local file="$1" identity uid mode
    [[ -f "$file" && ! -L "$file" && -r "$file" ]] || return 1
    identity="$(path_identity "$file")" || return 1
    uid="${identity%% *}"
    mode="${identity#* }"
    [[ "$uid" == "$(id -u)" && "$mode" == 600 ]]
}

sha256_tool() {
    if command_exists sha256sum; then
        printf '%s\n' sha256sum
    elif command_exists shasum; then
        printf '%s\n' 'shasum -a 256'
    else
        return 1
    fi
}

sha256_file() {
    local file="$1"
    if command_exists sha256sum; then
        sha256sum "$file" | awk '{print $1}'
    else
        shasum -a 256 "$file" | awk '{print $1}'
    fi
}

ansible_version_ok() {
    local version major minor local_temp remove_temp=false
    if [[ -n "${ANSIBLE_LOCAL_TEMP:-}" ]]; then
        local_temp="$ANSIBLE_LOCAL_TEMP"
    else
        local_temp="$(mktemp -d "${TMPDIR:-/tmp}/machstrap-version.XXXXXX")"
        chmod 700 "$local_temp"
        remove_temp=true
    fi
    version="$(ANSIBLE_LOCAL_TEMP="$local_temp" ansible-playbook --version 2>/dev/null | awk 'NR == 1 {gsub(/[][]/, "", $3); print $3}')"
    [[ "$remove_temp" == false ]] || rm -rf -- "$local_temp"
    major="${version%%.*}"
    minor="${version#*.}"
    minor="${minor%%.*}"
    [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
    (( major > MIN_ANSIBLE_MAJOR || (major == MIN_ANSIBLE_MAJOR && minor >= MIN_ANSIBLE_MINOR) ))
}

doctor_install_guidance() {
    local system distro=""
    system="$(uname -s 2>/dev/null || printf unknown)"
    if [[ "$system" == Linux && -r /etc/os-release ]]; then
        distro="$(sed -n 's/^ID=//p' /etc/os-release | head -n 1 | tr -d '"')"
    fi

    printf '\nInstall Ansible with your operating system'\''s trusted package manager, then\n'
    printf 'run `machstrap doctor` again.\n'
    case "$system:$distro" in
        Darwin:*)
            printf '  macOS/Homebrew:  brew install ansible\n'
            ;;
        Linux:debian|Linux:ubuntu|Linux:linuxmint|Linux:pop)
            printf '  Debian family:   sudo apt install ansible-core\n'
            ;;
        Linux:fedora|Linux:rhel|Linux:centos|Linux:rocky|Linux:almalinux)
            printf '  Red Hat family:  sudo dnf install ansible-core\n'
            ;;
        Linux:arch|Linux:manjaro)
            printf '  Arch family:     sudo pacman -S ansible-core\n'
            ;;
        Linux:alpine)
            printf '  Alpine:          sudo apk add ansible-core bash openssh-client tar\n'
            ;;
        Linux:opensuse*|Linux:sles)
            printf '  SUSE family:     sudo zypper install ansible\n'
            ;;
        FreeBSD:*|OpenBSD:*|NetBSD:*)
            printf '  BSD:             use pkg/pkg_add to install Ansible, Bash, and OpenSSH\n'
            ;;
        *)
            printf '  See: https://docs.ansible.com/ansible/latest/installation_guide/\n'
            ;;
    esac
    printf '\nmachstrap never installs packages or creates a Python environment itself.\n'
}

doctor() {
    local failed=0
    printf 'machstrap doctor\n'
    if [[ -n "${BASH_VERSION:-}" ]]; then
        doctor_ok "Bash $BASH_VERSION"
    else
        doctor_failure missing Bash
        failed=1
    fi
    for tool in ansible-playbook ssh tar; do
        if command_exists "$tool"; then
            doctor_ok "$tool: $(command -v "$tool")"
        else
            doctor_failure missing "$tool"
            failed=1
        fi
    done
    if command_exists ansible-playbook && ! ansible_version_ok; then
        doctor_failure unsupported "ansible-core $MIN_ANSIBLE_MAJOR.$MIN_ANSIBLE_MINOR or newer is required"
        failed=1
    fi
    if sha256_tool >/dev/null; then
        doctor_ok "SHA-256 utility"
    else
        doctor_failure missing "sha256sum or shasum"
        failed=1
    fi
    if (( failed != 0 )); then
        doctor_install_guidance
        return 1
    fi
    doctor_ready
}

require_runtime() {
    command_exists ansible-playbook || {
        err "ansible-playbook was not found; run 'machstrap doctor'"
        return 1
    }
    ansible_version_ok || {
        err "ansible-core $MIN_ANSIBLE_MAJOR.$MIN_ANSIBLE_MINOR or newer is required"
        return 1
    }
}

ansible_python_interpreter() {
    local launcher shebang interpreter
    launcher="$(command -v ansible-playbook)"
    [[ -f "$launcher" && -r "$launcher" ]] || return 1
    IFS= read -r shebang < "$launcher" || return 1
    if [[ "$shebang" =~ ^\#!(/[^[:space:]]+)$ ]]; then
        interpreter="${BASH_REMATCH[1]}"
    elif [[ "$shebang" =~ ^\#!/usr/bin/env[[:space:]]+python3?$ ]]; then
        interpreter="$(command -v python3)"
    else
        return 1
    fi
    [[ -x "$interpreter" ]] || return 1
    printf '%s\n' "$interpreter"
}

validate_yaml_file() {
    local file="$1" label="$2" interpreter
    interpreter="$(ansible_python_interpreter)" || return 0
    "$interpreter" - "$file" "$label" <<'PY'
import sys

try:
    import yaml
except ImportError:
    raise SystemExit(0)

path, label = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as profile:
        document = yaml.compose(profile)
except yaml.YAMLError as error:
    mark = getattr(error, "problem_mark", None)
    if mark is not None:
        print(
            f"machstrap: error: invalid YAML in {label}: {path}:{mark.line + 1}:{mark.column + 1}: {error.problem}",
            file=sys.stderr,
        )
    else:
        print(f"machstrap: error: invalid YAML in {label}: {path}: {error}", file=sys.stderr)
    raise SystemExit(2)


def mapping_value(node, name):
    if not isinstance(node, yaml.MappingNode):
        return None
    for key, value in node.value:
        if isinstance(key, yaml.ScalarNode) and key.value == name:
            return value
    return None


def source_error(node, field, problem):
    mark = node.start_mark
    print(
        f"machstrap: error: invalid {field} in {label}: "
        f"{path}:{mark.line + 1}:{mark.column + 1}: {problem}",
        file=sys.stderr,
    )
    raise SystemExit(2)


def is_string(node):
    return (
        isinstance(node, yaml.ScalarNode)
        and node.tag == "tag:yaml.org,2002:str"
    )


def validate_dotfiles(node, field):
    if node is None:
        return
    if not isinstance(node, yaml.SequenceNode):
        source_error(node, field, "expected a YAML list")
    allowed = {"path", "mode", "block", "lines"}
    for index, operation in enumerate(node.value, start=1):
        if not isinstance(operation, yaml.MappingNode):
            source_error(
                operation,
                f"{field}[{index}]",
                "expected a mapping with path, mode, block, and lines",
            )
        keys = {
            key.value
            for key, _ in operation.value
            if isinstance(key, yaml.ScalarNode)
        }
        operation_path = mapping_value(operation, "path")
        mode = mapping_value(operation, "mode")
        block = mapping_value(operation, "block")
        lines = mapping_value(operation, "lines")
        valid = (
            all(isinstance(key, yaml.ScalarNode) for key, _ in operation.value)
            and keys <= allowed
            and is_string(operation_path)
            and operation_path.value.startswith("~/")
            and is_string(mode)
            and mode.value in {"append", "prepend", "replace"}
            and is_string(block)
            and len(block.value) > 0
            and isinstance(lines, yaml.SequenceNode)
        )
        if not valid:
            source_error(
                operation,
                f"{field}[{index}]",
                "expected path under ~/, mode append/prepend/replace, "
                "a stable non-empty block, and a lines list",
            )


def validate_snap_packages(node, field):
    if node is None:
        return
    if not isinstance(node, yaml.SequenceNode):
        source_error(node, field, "expected a YAML list")
    allowed = {"name", "channel", "classic"}
    for index, package in enumerate(node.value, start=1):
        package_field = f"{field}[{index}]"
        if is_string(package):
            if len(package.value) == 0:
                source_error(package, package_field, "package name must not be empty")
            continue
        if not isinstance(package, yaml.MappingNode):
            source_error(
                package,
                package_field,
                "expected a package-name string or mapping",
            )
        keys = {
            key.value
            for key, _ in package.value
            if isinstance(key, yaml.ScalarNode)
        }
        name = mapping_value(package, "name")
        channel = mapping_value(package, "channel")
        classic = mapping_value(package, "classic")
        valid = (
            all(isinstance(key, yaml.ScalarNode) for key, _ in package.value)
            and keys <= allowed
            and is_string(name)
            and len(name.value) > 0
            and (channel is None or (is_string(channel) and len(channel.value) > 0))
            and (
                classic is None
                or (
                    isinstance(classic, yaml.ScalarNode)
                    and classic.tag == "tag:yaml.org,2002:bool"
                )
            )
        )
        if not valid:
            source_error(
                package,
                package_field,
                "expected a non-empty name and optional non-empty channel "
                "and boolean classic",
            )


profile = mapping_value(document, "machstrap_profile")
validate_dotfiles(mapping_value(profile, "dotfiles"), "machstrap_profile.dotfiles")
profile_packages = mapping_value(profile, "packages")
validate_snap_packages(
    mapping_value(profile_packages, "snap"),
    "machstrap_profile.packages.snap",
)


def validate_override_nodes(node):
    if isinstance(node, yaml.MappingNode):
        for key, value in node.value:
            if (
                isinstance(key, yaml.ScalarNode)
                and key.value in {"machstrap_overrides", "machstrap_vault_overrides"}
            ):
                validate_dotfiles(
                    mapping_value(value, "dotfiles"),
                    f"{key.value}.dotfiles",
                )
                packages = mapping_value(value, "packages")
                validate_snap_packages(
                    mapping_value(packages, "snap"),
                    f"{key.value}.packages.snap",
                )
            validate_override_nodes(value)
    elif isinstance(node, yaml.SequenceNode):
        for value in node.value:
            validate_override_nodes(value)


validate_override_nodes(document)
PY
}

validate_profile_yaml() {
    validate_yaml_file "$MACHSTRAP_PROFILE_FILE" profile
}

validate_inventory_yaml() {
    local inventory="$1" inventory_root variables_root file
    validate_yaml_file "$inventory" inventory || return $?
    inventory_root="$(dirname "$inventory")"
    for variables_root in "$inventory_root/group_vars" "$inventory_root/host_vars"; do
        [[ -d "$variables_root" && ! -L "$variables_root" ]] || continue
        while IFS= read -r file; do
            validate_yaml_file "$file" "inventory variable file" || return $?
        done < <(find "$variables_root" -type f ! -name '.*' -print | LC_ALL=C sort)
    done
}

resolve_profile() {
    local value="$1" candidate root configured profile_file status
    if [[ -d "$value" ]]; then
        profile_file="$(profile_file_path "$value")"
        status=$?
        if (( status != 0 )); then
            if (( status == 2 )); then
                err "profile directory contains both profile.yml and profile.yaml: $value"
            else
                err "profile.yml or profile.yaml not found: $value"
            fi
            return 1
        fi
        candidate="$profile_file"
    elif [[ -f "$value" ]]; then
        candidate="$value"
    elif [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        configured="$(configured_profile_candidate "$value")" || configured=""
        if [[ -n "$configured" ]]; then
            candidate="$(profile_file_path "$configured")"
        elif profile_file="$(profile_file_path "$RUNTIME_ROOT/profiles/$value")"; then
            candidate="$profile_file"
        else
            err "profile not found: $value"
            return 1
        fi
    else
        err "profile not found: $value"
        return 1
    fi
    candidate="$(canonical_file "$candidate")" || {
        err "profile file not found: $candidate"
        return 1
    }
    [[ "$(basename "$candidate")" == "profile.yml" || "$(basename "$candidate")" == "profile.yaml" ]] || {
        err "a profile file must be named profile.yml or profile.yaml: $candidate"
        return 1
    }
    root="$(canonical_directory "$(dirname "$candidate")")"
    [[ ! -L "$candidate" ]] || {
        err "profile files must not be symbolic links"
        return 1
    }
    MACHSTRAP_PROFILE_FILE="$candidate"
    MACHSTRAP_PROFILE_ROOT="$root"
    export MACHSTRAP_PROFILE_FILE MACHSTRAP_PROFILE_ROOT
}

contains_control_characters() {
    local value="$1"
    [[ "$value" == *$'\n'* || "$value" == *$'\r'* || "$value" == *$'\t'* ]]
}

validate_host() {
    local host="$1"
    [[ -n "$host" && "$host" != -* ]] || return 1
    contains_control_characters "$host" && return 1
    [[ "$host" != *" "* && "$host" != *","* && "$host" != *"'"* && "$host" != *'"'* ]]
}

validate_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

config_set_profile_root() {
    local requested="$1" canonical old_umask temp
    contains_control_characters "$requested" && {
        err "could not set the Machstrap profile directory: path contains control characters"
        return 2
    }
    canonical="$(canonical_directory "$requested")" || {
        err "could not set the Machstrap profile directory: directory not found: $requested"
        return 1
    }
    profile_root_safe "$canonical" || {
        err "could not set the Machstrap profile directory: it must be readable, searchable, and not group/world writable: $canonical"
        return 1
    }
    config_locations || {
        err "could not set the Machstrap profile directory: HOME or XDG_CONFIG_HOME must resolve to an absolute path"
        return 1
    }

    old_umask="$(umask)"
    umask 077
    mkdir -p "$MACHSTRAP_CONFIG_DIR" || {
        umask "$old_umask"
        err "could not set the Machstrap profile directory: could not create config directory: $MACHSTRAP_CONFIG_DIR"
        return 1
    }
    umask "$old_umask"
    secure_owned_config_path "$MACHSTRAP_CONFIG_DIR" directory 700 || {
        err "could not set the Machstrap profile directory: config directory must be user-owned, mode 0700, and not a symlink: $MACHSTRAP_CONFIG_DIR"
        return 1
    }
    if [[ -e "$MACHSTRAP_CONFIG_FILE" || -L "$MACHSTRAP_CONFIG_FILE" ]]; then
        secure_owned_config_path "$MACHSTRAP_CONFIG_FILE" file 600 || {
            err "could not set the Machstrap profile directory: refusing to replace unsafe config file: $MACHSTRAP_CONFIG_FILE"
            return 1
        }
    fi

    bootstrap_configured_content "$canonical" || return 1

    temp="$MACHSTRAP_CONFIG_DIR/.config.$$"
    [[ ! -e "$temp" && ! -L "$temp" ]] || {
        err "could not set the Machstrap profile directory: temporary config path already exists: $temp"
        return 1
    }
    if ! (umask 077; printf '%s\n' "$canonical" > "$temp"); then
        rm -f -- "$temp"
        err "could not set the Machstrap profile directory: could not write temporary config file"
        return 1
    fi
    if ! mv -f -- "$temp" "$MACHSTRAP_CONFIG_FILE"; then
        rm -f -- "$temp"
        err "could not set the Machstrap profile directory: could not install config file"
        return 1
    fi
    printf '%s\n' "$canonical"
    info "successfully set the Machstrap profile directory to: $canonical"
}

bootstrap_configured_content() {
    local root="$1" source destination name old_umask
    [[ -d "$RUNTIME_ROOT/profiles" && ! -L "$RUNTIME_ROOT/profiles" ]] || {
        err "could not bootstrap the Machstrap profile directory: bundled profiles are unavailable"
        return 1
    }
    [[ -d "$RUNTIME_ROOT/inventories/example" && ! -L "$RUNTIME_ROOT/inventories/example" ]] || {
        err "could not bootstrap the Machstrap profile directory: bundled inventory template is unavailable"
        return 1
    }
    if find "$RUNTIME_ROOT/profiles" "$RUNTIME_ROOT/inventories/example" -type l -print -quit | grep -q .; then
        err "could not bootstrap the Machstrap profile directory: bundled templates contain symbolic links"
        return 1
    fi

    old_umask="$(umask)"
    umask 077
    mkdir -p "$root/profiles" "$root/inventories" || {
        umask "$old_umask"
        err "could not bootstrap the Machstrap profile directory: failed to create collection directories"
        return 1
    }
    mkdir -p "$root/identities" || {
        umask "$old_umask"
        err "could not bootstrap the Machstrap profile directory: failed to create identities directory"
        return 1
    }
    umask "$old_umask"
    profile_root_safe "$root/profiles" && profile_root_safe "$root/inventories" &&
        profile_root_safe "$root/identities" || {
        err "could not bootstrap the Machstrap profile directory: collection directories must not be group/world writable"
        return 1
    }

    for source in "$RUNTIME_ROOT/profiles"/*; do
        [[ -d "$source" && ! -L "$source" ]] || continue
        profile_file_path "$source" >/dev/null || continue
        name="$(basename "$source")"
        destination="$root/profiles/$name"
        if [[ -e "$destination" || -L "$destination" ]]; then
            info "preserved existing profile: $destination"
        else
            cp -R "$source" "$destination" || {
                err "could not bootstrap the Machstrap profile directory: failed to copy profile: $name"
                return 1
            }
            info "copied bundled profile: $destination"
        fi
    done

    destination="$root/inventories/example"
    if [[ -e "$destination" || -L "$destination" ]]; then
        info "preserved existing inventory: $destination"
    else
        cp -R "$RUNTIME_ROOT/inventories/example" "$destination" || {
            err "could not bootstrap the Machstrap profile directory: failed to copy the inventory template"
            return 1
        }
        info "copied bundled inventory: $destination"
    fi
}

config_unset_profile_root() {
    config_locations || {
        err "HOME or XDG_CONFIG_HOME must resolve to an absolute path"
        return 1
    }
    if [[ ! -e "$MACHSTRAP_CONFIG_FILE" && ! -L "$MACHSTRAP_CONFIG_FILE" ]]; then
        info "no Machstrap profile directory was configured; nothing to unset"
        return 0
    fi
    secure_owned_config_path "$MACHSTRAP_CONFIG_DIR" directory 700 || {
        err "refusing to use unsafe config directory: $MACHSTRAP_CONFIG_DIR"
        return 1
    }
    secure_owned_config_path "$MACHSTRAP_CONFIG_FILE" file 600 || {
        err "refusing to remove unsafe config file: $MACHSTRAP_CONFIG_FILE"
        return 1
    }
    rm -f -- "$MACHSTRAP_CONFIG_FILE"
    info "successfully unset the Machstrap profile directory"
}

config_command() {
    if (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; then
        config_usage
        return
    fi
    if (( $# == 0 )); then
        if load_configured_profile_root; then
            printf '%s\n' "$CONFIGURED_PROFILE_ROOT"
            info "Machstrap profile directory: $CONFIGURED_PROFILE_ROOT"
            return 0
        fi
        if [[ "$MACHSTRAP_CONFIG_STATE" == missing ]]; then
            err "no Machstrap profile directory is configured; set one with: machstrap config PATH"
        else
            err "the configured Machstrap profile directory is invalid; set a valid one with: machstrap config PATH"
        fi
        return 1
    fi
    if (( $# == 1 )) && [[ "$1" == --unset ]]; then
        config_unset_profile_root
        return
    fi
    (( $# == 1 )) || {
        err "usage: machstrap config [PATH|--unset]"
        return 2
    }
    [[ "$1" != -* ]] || {
        err "unknown config option: $1"
        return 2
    }
    config_set_profile_root "$1"
}

profile_summary() {
    local profile_file="$1"
    awk '
        NR == 1 && $0 == "---" { next }
        /^[[:space:]]*$/ { next }
        /^#[[:space:]]*/ {
            line = $0
            sub(/^#[[:space:]]*/, "", line)
            if (length(line)) {
                gsub(/[[:cntrl:]]/, " ", line)
                print substr(line, 1, 160)
                exit
            }
            next
        }
        { exit }
    ' "$profile_file"
}

profile_records() {
    local root="$1" include_overrides="$2" directory name summary suffix profile_file runtime_profile
    for directory in "$root"/*; do
        profile_root_safe "$directory" || continue
        name="$(basename "$directory")"
        [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
        profile_file="$(profile_file_path "$directory")" || continue
        summary="$(profile_summary "$profile_file")"
        [[ -n "$summary" ]] || summary="No description."
        suffix=""
        runtime_profile="$(profile_file_path "$RUNTIME_ROOT/profiles/$name" 2>/dev/null)" || runtime_profile=""
        if [[ "$include_overrides" == true && -n "$runtime_profile" ]]; then
            suffix=" [overrides default]"
        fi
        printf '%s\t%s%s\n' "$name" "$summary" "$suffix"
    done | LC_ALL=C sort
}

render_profile_records() {
    local records="$1" name summary
    if [[ -z "$records" ]]; then
        printf '  (none)\n'
        return
    fi
    while IFS=$'\t' read -r name summary; do
        printf '  %-28s %s\n' "$name" "$summary"
    done <<< "$records"
}

profiles_command() {
    local subcommand="${1:-}" profile records profiles_root
    if (( $# == 0 )) || { (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; }; then
        profiles_usage
        return
    fi
    case "$subcommand" in
        list)
            (( $# == 1 )) || { err "usage: machstrap profiles list"; return 2; }
            load_configured_profile_root >/dev/null || true
            if [[ -z "$CONFIGURED_PROFILE_ROOT" ]]; then
                printf 'No profile directory configured. Run: machstrap config PATH\n'
                return 0
            fi
            profiles_root="$(configured_collection_root profiles)" || {
                printf 'No configured profiles directory. Run: machstrap config PATH\n'
                return 0
            }
            records="$(profile_records "$profiles_root" true)"
            printf 'Configured profiles (%s):\n' "$profiles_root"
            render_profile_records "$records"
            ;;
        default)
            (( $# == 1 )) || { err "usage: machstrap profiles default"; return 2; }
            records="$(profile_records "$RUNTIME_ROOT/profiles" false)"
            printf 'Default profiles:\n'
            render_profile_records "$records"
            ;;
        edit)
            (( $# == 2 )) || { err "usage: machstrap profiles edit PROFILE"; return 2; }
            profile="$2"
            [[ -t 0 && -t 1 ]] || {
                err "profiles edit requires an interactive terminal"
                return 1
            }
            resolve_profile "$profile"
            open_profile_editor "$MACHSTRAP_PROFILE_FILE"
            ;;
        browse)
            (( $# <= 2 )) || { err "usage: machstrap profiles browse [PROFILE]"; return 2; }
            if (( $# == 2 )); then
                resolve_profile "$2"
                show_in_file_manager "$(dirname "$MACHSTRAP_PROFILE_FILE")"
            else
                profiles_root="$(configured_collection_root profiles)" || { err "no configured profiles directory; set one with: machstrap config PATH"; return 1; }
                show_in_file_manager "$profiles_root"
            fi
            ;;
        new)
            shift
            profiles_new "$@"
            ;;
        delete)
            shift
            profiles_delete "$@"
            ;;
        *)
            err "unknown profiles command: $subcommand"
            err "usage: machstrap profiles list|default|edit PROFILE|browse [PROFILE]|new NAME|delete PROFILE"
            return 2
            ;;
    esac
}

profiles_delete() {
    local profile="" force=false profile_dir response profiles_root
    while (( $# )); do
        case "$1" in
            --help|-h) profiles_delete_usage; return ;;
            --force) force=true; shift ;;
            -*) err "unknown profiles delete option: $1"; return 2 ;;
            *) [[ -z "$profile" ]] || { err "profiles delete accepts one profile name"; return 2; }; profile="$1"; shift ;;
        esac
    done
    [[ -n "$profile" ]] || { err "profiles delete requires a profile name"; return 2; }
    valid_collection_name "$profile" || {
        err "invalid profile name: $profile"
        return 2
    }
    profiles_root="$(configured_collection_root profiles)" || {
        err "no Machstrap profile directory is configured; set one with: machstrap config PATH"
        return 1
    }
    profile_dir="$profiles_root/$profile"
    profile_root_safe "$profile_dir" && profile_file_path "$profile_dir" >/dev/null || {
        err "configured profile not found or unsafe: $profile"
        return 1
    }
    if [[ "$force" != true ]]; then
        [[ -t 0 && -t 1 ]] || {
            err "profiles delete requires an interactive terminal or --force"
            return 1
        }
        printf 'Delete configured profile %s and all of its files? [y/N] ' "$profile" >&2
        IFS= read -r response
        [[ "$response" == y || "$response" == Y || "$response" == yes || "$response" == YES ]] || {
            info "profile deletion cancelled"
            return 0
        }
    fi
    rm -rf -- "$profile_dir" || {
        err "could not delete configured profile: $profile"
        return 1
    }
    info "successfully deleted configured profile: $profile"
}

profiles_new() {
    local name="" destination="" out="" preset="full-example" force=false edit=true source configured profiles_root source_profile
    while (( $# )); do
        case "$1" in
            --help|-h) profiles_new_usage; return ;;
            --preset) [[ $# -ge 2 ]] || { err "--preset requires a value"; return 2; }; preset="$2"; shift 2 ;;
            --out) [[ $# -ge 2 ]] || { err "--out requires a directory"; return 2; }; out="$2"; shift 2 ;;
            --force) force=true; shift ;;
            --no-edit) edit=false; shift ;;
            -*) err "unknown profiles new option: $1"; return 2 ;;
            *) [[ -z "$name" ]] || { err "profiles new accepts one name"; return 2; }; name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || { err "profiles new requires a name"; return 2; }
    valid_collection_name "$name" || { err "invalid profile name: $name"; return 2; }
    if [[ -n "$out" ]]; then
        destination="$out"
    else
        profiles_root="$(configured_collection_root profiles)" || {
            err "no configured profiles directory; set one with: machstrap config PATH or use --out DIR"
            return 1
        }
        destination="$profiles_root/$name"
    fi
    [[ "$preset" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
        err "invalid preset name: $preset"
        return 2
    }
    configured="$(configured_profile_candidate "$preset")" || configured=""
    if [[ -n "$configured" ]]; then
        source="$configured"
    else
        source="$RUNTIME_ROOT/profiles/$preset"
    fi
    [[ -d "$source" && ! -L "$source" ]] || { err "unknown preset: $preset"; return 2; }
    source_profile="$(profile_file_path "$source")" || { err "unknown or ambiguous preset profile: $preset"; return 2; }
    if [[ -e "$destination" && "$force" != true ]]; then
        err "destination exists: $destination (use --force to replace an empty scaffold)"
        return 1
    fi
    if [[ -e "$destination" && "$force" == true ]]; then
        [[ -d "$destination" ]] || { err "destination is not a directory: $destination"; return 1; }
        [[ -z "$(find "$destination" -mindepth 1 -print -quit)" ]] || {
            err "--force only permits an existing empty directory"
            return 1
        }
    fi
    mkdir -p -- "$destination"
    cp -R "$source/." "$destination/"
    info "created profile: $destination"
    if [[ "$edit" == true && -t 0 && -t 1 ]]; then
        open_profile_editor "$destination/$(basename "$source_profile")" || true
    fi
}

inventory_records() {
    local root="$1" directory name
    for directory in "$root"/*; do
        profile_root_safe "$directory" || continue
        name="$(basename "$directory")"
        valid_collection_name "$name" || continue
        profile_file_safe "$directory/hosts.yml" || continue
        printf '%s\tInventory at %s\n' "$name" "$directory"
    done | LC_ALL=C sort
}

inventory_candidate() {
    local name="$1" root candidate
    valid_collection_name "$name" || return 1
    root="$(configured_collection_root inventories)" || return 1
    candidate="$root/$name"
    profile_root_safe "$candidate" && profile_file_safe "$candidate/hosts.yml" || return 1
    printf '%s\n' "$candidate"
}

default_inventory_candidate() {
    local name="$1" candidate="$RUNTIME_ROOT/inventories/$1"
    valid_collection_name "$name" || return 1
    profile_root_safe "$candidate" && profile_file_safe "$candidate/hosts.yml" || return 1
    printf '%s\n' "$candidate"
}

inventories_command() {
    local subcommand="${1:-}" name="" root records directory source destination out="" force=false edit=true preset="example"
    if (( $# == 0 )) || { (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; }; then
        inventories_usage
        return
    fi
    case "$subcommand" in
        list)
            (( $# == 1 )) || { err "usage: machstrap inventories list"; return 2; }
            root="$(configured_collection_root inventories)" || { printf 'No configured inventories directory. Run: machstrap config PATH\n'; return 0; }
            records="$(inventory_records "$root")"
            printf 'Configured inventories (%s):\n' "$root"
            render_profile_records "$records"
            ;;
        default)
            (( $# == 1 )) || { err "usage: machstrap inventories default"; return 2; }
            records="$(inventory_records "$RUNTIME_ROOT/inventories")"
            printf 'Default inventories:\n'
            render_profile_records "$records"
            ;;
        edit)
            (( $# == 2 )) || { err "usage: machstrap inventories edit INVENTORY"; return 2; }
            [[ -t 0 && -t 1 ]] || { err "inventories edit requires an interactive terminal"; return 1; }
            name="$2"
            directory="$(inventory_candidate "$name")" || directory="$(default_inventory_candidate "$name")" || {
                err "inventory not found: $name"; return 1;
            }
            open_profile_editor "$directory/hosts.yml"
            ;;
        browse)
            (( $# == 1 )) || { err "usage: machstrap inventories browse"; return 2; }
            root="$(configured_collection_root inventories)" || { err "no configured inventories directory; set one with: machstrap config PATH"; return 1; }
            show_in_file_manager "$root"
            ;;
        new)
            shift
            while (( $# )); do
                case "$1" in
                    --help|-h) inventories_usage; return ;;
                    --out) [[ $# -ge 2 ]] || { err "--out requires a directory"; return 2; }; out="$2"; shift 2 ;;
                    --preset) [[ $# -ge 2 ]] || { err "--preset requires a value"; return 2; }; preset="$2"; shift 2 ;;
                    --force) force=true; shift ;;
                    --no-edit) edit=false; shift ;;
                    -*) err "unknown inventories new option: $1"; return 2 ;;
                    *) [[ -z "$name" ]] || { err "inventories new accepts one name"; return 2; }; name="$1"; shift ;;
                esac
            done
            [[ -n "$name" ]] && valid_collection_name "$name" || { err "inventories new requires a valid name"; return 2; }
            valid_collection_name "$preset" || { err "invalid preset name: $preset"; return 2; }
            source="$(default_inventory_candidate "$preset")" || { err "unknown inventory preset: $preset"; return 2; }
            if [[ -n "$out" ]]; then destination="$out"; else
                root="$(configured_collection_root inventories)" || { err "no configured inventories directory; set one with: machstrap config PATH or use --out DIR"; return 1; }
                destination="$root/$name"
            fi
            if [[ -e "$destination" && "$force" != true ]]; then err "destination exists: $destination (use --force to replace an empty scaffold)"; return 1; fi
            if [[ -e "$destination" && "$force" == true ]]; then
                [[ -d "$destination" && -z "$(find "$destination" -mindepth 1 -print -quit)" ]] || { err "--force only permits an existing empty directory"; return 1; }
            fi
            mkdir -p -- "$destination" && cp -R "$source/." "$destination/" || { err "could not create inventory: $destination"; return 1; }
            info "created inventory: $destination"
            [[ "$edit" != true || ! -t 0 || ! -t 1 ]] || open_profile_editor "$destination/hosts.yml" || true
            ;;
        delete)
            shift
            inventories_delete "$@"
            ;;
        *) err "unknown inventories command: $subcommand"; err "usage: machstrap inventories list|default|edit INVENTORY|browse|new NAME|delete INVENTORY"; return 2 ;;
    esac
}

inventories_delete() {
    local name="" force=false root directory response
    while (( $# )); do case "$1" in --help|-h) inventories_usage; return ;; --force) force=true; shift ;; -*) err "unknown inventories delete option: $1"; return 2 ;; *) [[ -z "$name" ]] || { err "inventories delete accepts one name"; return 2; }; name="$1"; shift ;; esac; done
    [[ -n "$name" ]] && valid_collection_name "$name" || { err "inventories delete requires a valid name"; return 2; }
    root="$(configured_collection_root inventories)" || { err "no configured inventories directory; set one with: machstrap config PATH"; return 1; }
    directory="$root/$name"
    profile_root_safe "$directory" && profile_file_safe "$directory/hosts.yml" || { err "configured inventory not found or unsafe: $name"; return 1; }
    if [[ "$force" != true ]]; then [[ -t 0 && -t 1 ]] || { err "inventories delete requires an interactive terminal or --force"; return 1; }; printf 'Delete configured inventory %s and all of its files? [y/N] ' "$name" >&2; IFS= read -r response; [[ "$response" == y || "$response" == Y || "$response" == yes || "$response" == YES ]] || { info "inventory deletion cancelled"; return 0; }; fi
    rm -rf -- "$directory" || { err "could not delete configured inventory: $name"; return 1; }
    info "successfully deleted configured inventory: $name"
}

identities_command() {
    local subcommand="${1:-}" name root file records response force=false
    if (( $# == 0 )) || { (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; }; then identities_usage; return; fi
    case "$subcommand" in
        list)
            (( $# == 1 )) || { err "usage: machstrap identities list"; return 2; }
            root="$(configured_collection_root identities)" || { printf 'No configured identities directory. Run: machstrap config PATH\n'; return 0; }
            records=""
            for file in "$root"/*; do identity_file_safe "$file" || continue; name="$(basename "$file")"; valid_collection_name "$name" || continue; records+="$name"$'\t'"$file"$'\n'; done
            printf 'Configured identities (%s):\n' "$root"
            render_profile_records "$(printf '%s' "$records" | LC_ALL=C sort)"
            ;;
        edit)
            (( $# == 2 )) || { err "usage: machstrap identities edit IDENTITY"; return 2; }
            [[ -t 0 && -t 1 ]] || { err "identities edit requires an interactive terminal"; return 1; }
            valid_collection_name "$2" || { err "invalid identity name: $2"; return 2; }
            root="$(configured_collection_root identities)" || { err "no configured identities directory; set one with: machstrap config PATH"; return 1; }
            file="$root/$2"; identity_file_safe "$file" || { err "configured identity not found or unsafe: $2"; return 1; }
            open_profile_editor "$file"
            ;;
        browse)
            (( $# == 1 )) || { err "usage: machstrap identities browse"; return 2; }
            root="$(configured_collection_root identities)" || { err "no configured identities directory; set one with: machstrap config PATH"; return 1; }
            show_in_file_manager "$root"
            ;;
        delete)
            shift; identities_delete "$@" ;;
        *) err "unknown identities command: $subcommand"; err "usage: machstrap identities list|edit IDENTITY|browse|delete IDENTITY"; return 2 ;;
    esac
}

identities_delete() {
    local name="" force=false root file response
    while (( $# )); do case "$1" in --help|-h) identities_usage; return ;; --force) force=true; shift ;; -*) err "unknown identities delete option: $1"; return 2 ;; *) [[ -z "$name" ]] || { err "identities delete accepts one name"; return 2; }; name="$1"; shift ;; esac; done
    [[ -n "$name" ]] && valid_collection_name "$name" || { err "identities delete requires a valid name"; return 2; }
    root="$(configured_collection_root identities)" || { err "no configured identities directory; set one with: machstrap config PATH"; return 1; }
    file="$root/$name"; identity_file_safe "$file" || { err "configured identity not found or unsafe: $name"; return 1; }
    if [[ "$force" != true ]]; then [[ -t 0 && -t 1 ]] || { err "identities delete requires an interactive terminal or --force"; return 1; }; printf 'Delete configured identity %s? [y/N] ' "$name" >&2; IFS= read -r response; [[ "$response" == y || "$response" == Y || "$response" == yes || "$response" == YES ]] || { info "identity deletion cancelled"; return 0; }; fi
    rm -f -- "$file" || { err "could not delete configured identity: $name"; return 1; }
    info "successfully deleted configured identity: $name"
}

open_profile_editor() {
    local profile_file="$1" editor
    local -a editor_command

    editor="${VISUAL:-${EDITOR:-vi}}"
    read -r -a editor_command <<< "$editor"
    if (( ${#editor_command[@]} == 0 )) || ! command_exists "${editor_command[0]}"; then
        warn "could not open profile; the configured editor is unavailable: $editor"
        return 1
    fi
    info "opening profile in editor: $profile_file"
    "${editor_command[@]}" "$profile_file" || {
        warn "could not open profile; the editor exited unsuccessfully"
        return 1
    }
}

show_in_file_manager() {
    local path="$1"
    [[ -d "$path" && ! -L "$path" ]] || { err "cannot open missing or unsafe directory: $path"; return 1; }
    case "$(uname -s)" in
        Darwin)
            command_exists open || { err "the system file manager is unavailable"; return 1; }
            info "opening in file manager: $path"
            open "$path"
            ;;
        Linux)
            command_exists xdg-open || { err "xdg-open is required to show files in the system file manager"; return 1; }
            info "opening in file manager: $path"
            xdg-open "$path"
            ;;
        *)
            err "showing files in the system file manager is unsupported on this platform"
            return 1
            ;;
    esac
}

check_profile_tree() {
    local root="$1" count total
    if [[ -n "$(find "$root" -type l -print -quit)" ]]; then
        err "profiles and bundles may not contain symbolic links"
        return 1
    fi
    if [[ -n "$(find "$root" -type f -size +"${BUNDLE_MAX_FILE_KIB}"k -print -quit)" ]]; then
        err "a profile file exceeds ${BUNDLE_MAX_FILE_KIB} KiB"
        return 1
    fi
    count="$(find "$root" -type f | wc -l | tr -d ' ')"
    (( count <= BUNDLE_MAX_FILES )) || {
        err "profile contains $count files; limit is $BUNDLE_MAX_FILES"
        return 1
    }
    total="$(du -sk "$root" | awk '{print $1}')"
    (( total <= BUNDLE_MAX_TOTAL_KIB )) || {
        err "profile expands to ${total} KiB; limit is ${BUNDLE_MAX_TOTAL_KIB} KiB"
        return 1
    }
    if find "$root" -print | LC_ALL=C grep -q '[[:cntrl:]]'; then
        err "profile paths may not contain control characters"
        return 1
    fi
}

write_manifest() {
    local root="$1" manifest relative hash
    manifest="$root/MANIFEST.sha256"
    : > "$manifest"
    while IFS= read -r relative; do
        [[ "$relative" == "./MANIFEST.sha256" ]] && continue
        hash="$(sha256_file "$root/${relative#./}")"
        printf '%s  %s\n' "$hash" "${relative#./}" >> "$manifest"
    done < <(cd "$root" && find . -type f | LC_ALL=C sort)
}

bundle_create() {
    local profile="" output="" force=false staging bundle_root
    while (( $# )); do
        case "$1" in
            --help|-h) bundle_usage; return ;;
            --out|-o) [[ $# -ge 2 ]] || { err "--out requires a value"; return 2; }; output="$2"; shift 2 ;;
            --force) force=true; shift ;;
            -*) err "unknown bundle option: $1"; return 2 ;;
            *) [[ -z "$profile" ]] || { err "bundle accepts one profile"; return 2; }; profile="$1"; shift ;;
        esac
    done
    [[ -n "$profile" && -n "$output" ]] || { err "bundle requires PROFILE and --out FILE.machstrap"; return 2; }
    [[ "$output" == *.machstrap ]] || { err "bundle output must end in .machstrap"; return 2; }
    [[ ! -e "$output" || "$force" == true ]] || { err "bundle exists: $output"; return 1; }
    resolve_profile "$profile"
    check_profile_tree "$MACHSTRAP_PROFILE_ROOT"
    ACTIVE_TMP="$(mktemp -d "${TMPDIR:-/tmp}/machstrap-bundle.XXXXXX")"
    chmod 700 "$ACTIVE_TMP"
    bundle_root="$ACTIVE_TMP/machstrap"
    mkdir -p "$bundle_root/profiles/bundled"
    cp "$RUNTIME_ROOT/machstrap" "$RUNTIME_ROOT/ansible.cfg" \
        "$RUNTIME_ROOT/VERSION" "$bundle_root/"
    cp -R "$RUNTIME_ROOT/config" "$RUNTIME_ROOT/playbooks" "$RUNTIME_ROOT/roles" "$bundle_root/"
    cp -R "$MACHSTRAP_PROFILE_ROOT/." "$bundle_root/profiles/bundled/"
    check_profile_tree "$bundle_root"
    write_manifest "$bundle_root"
    mkdir -p "$(dirname "$output")"
    staging="$ACTIVE_TMP/archive.machstrap"
    tar -czf "$staging" -C "$ACTIVE_TMP" machstrap
    mv -f -- "$staging" "$output"
    rm -rf -- "$ACTIVE_TMP"
    ACTIVE_TMP=""
    info "bundle created: $output"
    warn "the manifest detects corruption, not malicious replacement; distribute bundles through a trusted channel"
}

safe_bundle_member() {
    local member="$1"
    [[ -n "$member" && "$member" != /* && "$member" != *$'\n'* && "$member" != *$'\r'* ]] || return 1
    [[ "$member" != *\\* ]] || return 1
    case "/$member/" in
        */../*|*/./*) return 1 ;;
    esac
    [[ "$member" == machstrap || "$member" == machstrap/* ]]
}

verify_manifest() {
    local root="$1" manifest line hash path actual listed actual_count manifest_count
    manifest="$root/MANIFEST.sha256"
    [[ -f "$manifest" && ! -L "$manifest" ]] || { err "bundle manifest is missing"; return 1; }
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^([0-9a-f]{64})[[:space:]][[:space:]]([^[:cntrl:]]+)$ ]] || {
            err "bundle manifest contains an invalid record"
            return 1
        }
        hash="${BASH_REMATCH[1]}"
        path="${BASH_REMATCH[2]}"
        safe_bundle_member "machstrap/$path" || { err "unsafe manifest path: $path"; return 1; }
        [[ -f "$root/$path" && ! -L "$root/$path" ]] || { err "manifest file missing: $path"; return 1; }
        actual="$(sha256_file "$root/$path")"
        [[ "$actual" == "$hash" ]] || { err "bundle hash mismatch: $path"; return 1; }
    done < "$manifest"
    listed="$(awk '{sub(/^[0-9a-f]+  /, ""); print}' "$manifest" | LC_ALL=C sort)"
    actual="$(cd "$root" && find . -type f ! -name MANIFEST.sha256 | sed 's#^./##' | LC_ALL=C sort)"
    [[ "$listed" == "$actual" ]] || { err "bundle manifest does not exactly cover its files"; return 1; }
    actual_count="$(printf '%s\n' "$actual" | awk 'NF {count++} END {print count+0}')"
    manifest_count="$(wc -l < "$manifest" | tr -d ' ')"
    [[ "$actual_count" == "$manifest_count" ]] || { err "bundle manifest file count mismatch"; return 1; }
}

extract_bundle() {
    local archive="$1" member listing bundled_profile
    archive="$(canonical_file "$archive")" || { err "bundle not found: $archive"; return 1; }
    ACTIVE_TMP="$(mktemp -d "${TMPDIR:-/tmp}/machstrap-apply.XXXXXX")"
    chmod 700 "$ACTIVE_TMP"
    listing="$ACTIVE_TMP/members"
    tar -tzf "$archive" > "$listing" || { err "could not list bundle"; return 1; }
    if LC_ALL=C sort "$listing" | uniq -d | grep -q .; then
        err "bundle contains duplicate archive members"
        return 1
    fi
    while IFS= read -r member; do
        safe_bundle_member "$member" || { err "unsafe bundle member: $member"; return 1; }
    done < "$listing"
    if tar -tvzf "$archive" | awk '$1 ~ /^[lh]/ {found=1} END {exit !found}'; then
        err "bundle contains symbolic or hard links"
        return 1
    fi
    tar -xzf "$archive" -C "$ACTIVE_TMP"
    RUNTIME_ROOT="$ACTIVE_TMP/machstrap"
    bundled_profile="$(profile_file_path "$RUNTIME_ROOT/profiles/bundled")" || {
        err "bundle runtime is incomplete"
        return 1
    }
    [[ -f "$RUNTIME_ROOT/playbooks/site.yml" ]] || {
        err "bundle runtime is incomplete"
        return 1
    }
    verify_manifest "$RUNTIME_ROOT"
    resolve_profile "$RUNTIME_ROOT/profiles/bundled"
}

interactive_terminal_available() {
    [[ -t 0 && -t 1 && -t 2 ]] || return 1
    ( : </dev/tty >/dev/tty ) 2>/dev/null
}

inventory_ssh_record() {
    local inventory="$1" limit="$2" vault_file="$3" ask_vault="$4"
    local interpreter inventory_json status
    local -a inventory_command
    interpreter="$(ansible_python_interpreter)" || return 1
    inventory_json="$(mktemp "${TMPDIR:-/tmp}/machstrap-inventory.XXXXXX")"
    chmod 600 "$inventory_json"
    inventory_command=(ansible-inventory --inventory "$inventory" --list --limit "$limit")
    [[ -z "$vault_file" ]] || inventory_command+=(--vault-password-file "$vault_file")
    [[ "$ask_vault" != true ]] || inventory_command+=(--ask-vault-pass)
    set +e
    ANSIBLE_CONFIG="$RUNTIME_ROOT/ansible.cfg" \
    ANSIBLE_LOCAL_TEMP="${ANSIBLE_LOCAL_TEMP:-${TMPDIR:-/tmp}}" \
        "${inventory_command[@]}" >"$inventory_json"
    status=$?
    set -e
    if (( status != 0 )); then
        rm -f -- "$inventory_json"
        return "$status"
    fi
    set +e
    "$interpreter" - "$inventory_json" "$inventory" <<'PY'
import json
import os
import re
import shlex
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        inventory = json.load(source)
except (ValueError, OSError):
    raise SystemExit(1)

hostvars = inventory.get("_meta", {}).get("hostvars", {})
if len(hostvars) != 1:
    raise SystemExit(1)

name, variables = next(iter(hostvars.items()))
inventory_file = os.path.realpath(sys.argv[2])
inventory_dir = os.path.dirname(inventory_file)
values = [
    name,
    variables.get("ansible_host", variables.get("ansible_ssh_host", name)),
    variables.get("ansible_user", variables.get("ansible_ssh_user", "")),
    variables.get("ansible_port", variables.get("ansible_ssh_port", "")),
    variables.get(
        "ansible_ssh_private_key_file",
        variables.get("ansible_private_key_file", ""),
    ),
]
for value in values:
    value = str(value)
    if any(character in value for character in "\r\n\t"):
        raise SystemExit(1)
    print(value)
for variable in (
    "ansible_ssh_args",
    "ansible_ssh_common_args",
    "ansible_ssh_extra_args",
):
    raw_arguments = str(variables.get(variable, ""))
    raw_arguments = re.sub(
        r"{{\s*inventory_dir\s*}}",
        inventory_dir,
        raw_arguments,
    )
    raw_arguments = re.sub(
        r"{{\s*inventory_file\s*}}",
        inventory_file,
        raw_arguments,
    )
    if any(token in raw_arguments for token in ("{{", "}}", "{%", "%}")):
        print(f"UNRESOLVED:{variable}")
        continue
    for argument in shlex.split(raw_arguments):
        if any(character in argument for character in "\r\n\t"):
            raise SystemExit(1)
        print(f"ARG:{argument}")
print("MACHSTRAP_SSH_RECORD")
PY
    status=$?
    set -e
    rm -f -- "$inventory_json"
    return "$status"
}

resolved_ssh_plan() {
    local inventory_host="$1" endpoint="$2" user="$3" port="$4" identity="$5" ssh_config="$6" show="$7"
    local line key value effective_host="" effective_user="" effective_port=""
    local strict="" host_key_alias="" known_hosts="" global_known_hosts=""
    local plan_output plan_error ssh_status inventory_config="" argument_index
    local -a ssh_arguments effective_lines
    ssh_arguments=()
    effective_lines=()
    [[ -z "$ssh_config" ]] || ssh_arguments+=(-F "$ssh_config")
    [[ -z "$user" ]] || ssh_arguments+=(-l "$user")
    [[ -z "$port" ]] || ssh_arguments+=(-p "$port")
    [[ -z "$identity" ]] || ssh_arguments+=(-i "$identity")
    ssh_arguments+=("${ssh_inventory_args[@]}")
    for (( argument_index=0; argument_index<${#ssh_inventory_args[@]}; argument_index++ )); do
        case "${ssh_inventory_args[$argument_index]}" in
            -F)
                if (( argument_index + 1 < ${#ssh_inventory_args[@]} )); then
                    inventory_config="${ssh_inventory_args[$((argument_index + 1))]}"
                fi
                ;;
            -F?*) inventory_config="${ssh_inventory_args[$argument_index]#-F}" ;;
        esac
    done
    plan_output="$(mktemp "${TMPDIR:-/tmp}/machstrap-ssh-plan.XXXXXX")"
    plan_error="$(mktemp "${TMPDIR:-/tmp}/machstrap-ssh-plan-error.XXXXXX")"
    chmod 600 "$plan_output" "$plan_error"
    set +e
    ssh -G "${ssh_arguments[@]}" "$endpoint" >"$plan_output" 2>"$plan_error"
    ssh_status=$?
    set -e
    if (( ssh_status != 0 )); then
        err "OpenSSH could not resolve connection settings for: $endpoint"
        while IFS= read -r line; do
            [[ -n "$line" ]] && warn "OpenSSH: $line"
        done <"$plan_error"
        rm -f -- "$plan_output" "$plan_error"
        return 1
    fi
    while IFS= read -r line; do
        effective_lines+=("$line")
        key="${line%% *}"
        value="${line#* }"
        case "$key" in
            hostname) effective_host="$value" ;;
            user) effective_user="$value" ;;
            port) effective_port="$value" ;;
            stricthostkeychecking) strict="$value" ;;
            hostkeyalias) host_key_alias="$value" ;;
            userknownhostsfile) known_hosts="$value" ;;
            globalknownhostsfile) global_known_hosts="$value" ;;
        esac
    done <"$plan_output"
    rm -f -- "$plan_output" "$plan_error"
    if [[ -z "$effective_host" || -z "$effective_user" || -z "$effective_port" ]]; then
        err "OpenSSH returned an incomplete connection plan for: $endpoint"
        [[ -n "$effective_host" ]] || warn "OpenSSH did not provide HostName"
        [[ -n "$effective_user" ]] || warn "OpenSSH did not provide User"
        [[ -n "$effective_port" ]] || warn "OpenSSH did not provide Port"
        return 1
    fi

    if [[ "$show" == true ]]; then
        printf 'SSH CONNECTION PLAN\n'
        printf '  Inventory host: %s\n' "$inventory_host"
        printf '  Endpoint:       %s\n' "$effective_host"
        printf '  User:           %s\n' "$effective_user"
        printf '  Port:           %s\n' "$effective_port"
        printf '  SSH config:     %s\n' "${ssh_config:-${inventory_config:-OpenSSH defaults}}"
        for line in "${effective_lines[@]}"; do
            case "$line" in
                proxycommand\ *)
                    printf '  proxycommand <configured; hidden from report>\n'
                    ;;
                identityfile\ *|proxyjump\ *|userknownhostsfile\ *|hostkeyalias\ *)
                    printf '  %s\n' "$line"
                    ;;
            esac
        done
    fi

    MACHSTRAP_SSH_PLAN_HOST="$effective_host"
    MACHSTRAP_SSH_PLAN_PORT="$effective_port"
    MACHSTRAP_SSH_PLAN_ALIAS="$host_key_alias"
    MACHSTRAP_SSH_PLAN_STRICT="$strict"
    MACHSTRAP_SSH_PLAN_KNOWN="$known_hosts $global_known_hosts"
    MACHSTRAP_SSH_PLAN_TARGET="$endpoint"
    MACHSTRAP_SSH_PLAN_ARGS=("${ssh_arguments[@]}")
}

ssh_host_key_known() {
    local lookup="$MACHSTRAP_SSH_PLAN_HOST" file
    local -a known_files
    [[ -z "$MACHSTRAP_SSH_PLAN_ALIAS" || "$MACHSTRAP_SSH_PLAN_ALIAS" == none ]] ||
        lookup="$MACHSTRAP_SSH_PLAN_ALIAS"
    [[ "$MACHSTRAP_SSH_PLAN_PORT" == 22 ]] ||
        lookup="[$lookup]:$MACHSTRAP_SSH_PLAN_PORT"
    read -r -a known_files <<<"$MACHSTRAP_SSH_PLAN_KNOWN"
    for file in "${known_files[@]}"; do
        [[ -n "$file" && "$file" != none ]] || continue
        [[ "$file" != "~/"* ]] || file="${HOME:?}/${file#\~/}"
        ssh-keygen -F "$lookup" -f "$file" >/dev/null 2>&1 && return 0
    done
    return 1
}

run_ssh_handshake() {
    local explicit="$1"
    if ssh_host_key_known && [[ "$explicit" != true ]]; then
        return 0
    fi
    if [[ "$explicit" != true ]]; then
        case "$MACHSTRAP_SSH_PLAN_STRICT" in
            no|off|false|accept-new) return 0 ;;
        esac
    fi
    if ! interactive_terminal_available; then
        [[ "$explicit" != true ]] || {
            err "interactive SSH handshake requires a usable interactive terminal and /dev/tty"
            return 2
        }
        return 0
    fi
    info "checking the SSH handshake for $MACHSTRAP_SSH_PLAN_TARGET"
    set +e
    ssh "${MACHSTRAP_SSH_PLAN_ARGS[@]}" \
        -o NumberOfPasswordPrompts=0 \
        "$MACHSTRAP_SSH_PLAN_TARGET" true </dev/tty >/dev/tty 2>/dev/tty
    local ssh_status=$?
    set -e
    if (( ssh_status != 0 )) && ! ssh_host_key_known; then
        err "SSH handshake failed before the host key was trusted"
        return "$ssh_status"
    fi
    return 0
}

run_ansible() {
    local action="$1" profile="$2"
    shift 2
    local target_mode="" inventory="" limit="" all=false host="" user="" port="" identity="" ssh_config=""
    local check=false diff=false ask_pass=false ask_become=false ask_vault=false vault_file=""
    local interactive=false prompt_available=false ssh_plan=false ssh_preflight=false
    local tags="" skip_tags="" verbosity=""
    local inventory_host="" ssh_endpoint="" ssh_user="" ssh_port="" ssh_identity="" need_ssh=false
    local ssh_unresolved=""
    local -a command ssh_record ssh_inventory_args
    local target_description mode started ansible_status line record_index
    ssh_inventory_args=()

    while (( $# )); do
        case "$1" in
            --local|--here) [[ -z "$target_mode" ]] || { err "choose only one target mode"; return 2; }; target_mode=local; shift ;;
            --inventory|-i) [[ $# -ge 2 ]] || { err "--inventory requires a path"; return 2; }; [[ -z "$target_mode" || "$target_mode" == inventory || "$target_mode" == host ]] || { err "choose only one target mode"; return 2; }; target_mode=inventory; inventory="$2"; shift 2 ;;
            --limit|-l) [[ $# -ge 2 ]] || { err "--limit requires a value"; return 2; }; limit="$2"; shift 2 ;;
            --all) all=true; shift ;;
            --host) [[ $# -ge 2 ]] || { err "--host requires a value"; return 2; }; [[ -z "$host" ]] || { err "--host may be specified only once"; return 2; }; [[ -z "$target_mode" || "$target_mode" == inventory ]] || { err "choose only one target mode"; return 2; }; [[ -n "$target_mode" ]] || target_mode=host; host="$2"; shift 2 ;;
            --user|-u) [[ $# -ge 2 ]] || { err "--user requires a value"; return 2; }; user="$2"; shift 2 ;;
            --port|-p) [[ $# -ge 2 ]] || { err "--port requires a value"; return 2; }; port="$2"; shift 2 ;;
            --identity) [[ $# -ge 2 ]] || { err "--identity requires a path"; return 2; }; identity="$2"; shift 2 ;;
            --ssh-config) [[ $# -ge 2 ]] || { err "--ssh-config requires a path"; return 2; }; ssh_config="$2"; shift 2 ;;
            --dry-run|--check) check=true; shift ;;
            --diff) diff=true; shift ;;
            --ask-pass|-k) ask_pass=true; shift ;;
            --ask-sudo-pass|--ask-become-pass|-K) ask_become=true; shift ;;
            --ask-vault-pass) ask_vault=true; shift ;;
            --interactive|--forward-all) interactive=true; shift ;;
            --ssh-plan) ssh_plan=true; shift ;;
            --ssh-preflight) ssh_preflight=true; shift ;;
            --vault-password-file) [[ $# -ge 2 ]] || { err "--vault-password-file requires a path"; return 2; }; vault_file="$2"; shift 2 ;;
            --tags) [[ $# -ge 2 ]] || { err "--tags requires a value"; return 2; }; tags="$2"; shift 2 ;;
            --skip-tags) [[ $# -ge 2 ]] || { err "--skip-tags requires a value"; return 2; }; skip_tags="$2"; shift 2 ;;
            -v|-vv|-vvv|-vvvv) verbosity="$1"; shift ;;
            *) err "unknown apply/check option: $1"; return 2 ;;
        esac
    done

    [[ -n "$target_mode" ]] || { err "choose --local, --inventory, or --host"; return 2; }
    if [[ "$interactive" == true ]]; then
        interactive_terminal_available || {
            err "--interactive requires a usable interactive terminal, including readable and writable /dev/tty"
            return 2
        }
        ask_pass=true
        ask_become=true
        [[ -n "$vault_file" ]] || ask_vault=true
    fi
    if [[ "$ssh_preflight" == true ]]; then
        interactive_terminal_available || {
            err "--ssh-preflight requires a usable interactive terminal, including readable and writable /dev/tty"
            return 2
        }
    fi
    if [[ "$action" == apply && "$check" != true ]] && interactive_terminal_available; then
        prompt_available=true
    fi
    [[ "$all" != true || "$target_mode" == inventory ]] || { err "--all requires --inventory"; return 2; }
    [[ -z "$limit" || "$target_mode" == inventory ]] || { err "--limit requires --inventory"; return 2; }
    if [[ "$target_mode" == inventory && -z "$limit" && "$all" != true ]]; then
        err "inventory runs require --limit or explicit --all"
        return 2
    fi
    if [[ -z "$host" && ( -n "$user" || -n "$port" || -n "$identity" ) ]]; then
        err "SSH endpoint options require --host"
        return 2
    fi
    if [[ -n "$ssh_config" && "$target_mode" == local ]]; then
        err "--ssh-config requires --inventory or --host"
        return 2
    fi
    if [[ "$target_mode" == local && ( "$ssh_plan" == true || "$ssh_preflight" == true || "$interactive" == true || "$ask_pass" == true ) ]]; then
        err "SSH interaction options require --inventory or --host"
        return 2
    fi
    if [[ -n "$user" && ! "$user" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
        err "invalid SSH user"
        return 2
    fi
    if [[ "$target_mode" == inventory && -n "$host" ]]; then
        [[ "$all" != true && -n "$limit" ]] || {
            err "an inventory SSH endpoint override requires one explicit --limit host"
            return 2
        }
    fi

    if [[ "$profile" == *.machstrap ]]; then
        extract_bundle "$profile"
    else
        resolve_profile "$profile"
    fi
    require_runtime
    validate_profile_yaml || return $?

    command=(ansible-playbook)
    if [[ "$action" == check ]]; then
        command+=("$RUNTIME_ROOT/playbooks/validate.yml")
    else
        command+=("$RUNTIME_ROOT/playbooks/site.yml")
    fi
    if [[ -n "$ssh_config" ]]; then
        ssh_config="$(canonical_file "$ssh_config")" || { err "SSH config not found: $ssh_config"; return 1; }
        contains_control_characters "$ssh_config" && { err "SSH config path contains control characters"; return 2; }
        [[ "$ssh_config" != *"'"* ]] || { err "SSH config path may not contain a single quote"; return 2; }
        export ANSIBLE_SSH_ARGS="-F '$ssh_config'"
    fi
    if [[ -n "$vault_file" ]]; then
        vault_file="$(canonical_file "$vault_file")" || { err "vault password file not found: $vault_file"; return 1; }
    fi

    case "$target_mode" in
        local)
            command+=(--inventory 'localhost,' --connection local)
            target_description=local
            ;;
        inventory)
            inventory="$(canonical_file "$inventory")" || { err "inventory not found: $inventory"; return 1; }
            validate_inventory_yaml "$inventory" || return $?
            command+=(--inventory "$inventory")
            [[ -n "$limit" ]] && command+=(--limit "$limit")
            target_description="$inventory (${limit:-all hosts})"
            if [[ -n "$host" ]]; then
                validate_host "$host" || { err "invalid SSH host: $host"; return 2; }
                command+=(--extra-vars "machstrap_transient_endpoint=true" --extra-vars "ansible_host=$host")
                [[ -n "$user" ]] && command+=(--extra-vars "ansible_user=$user")
                if [[ -n "$port" ]]; then
                    validate_port "$port" || { err "port must be between 1 and 65535"; return 2; }
                    command+=(--extra-vars "ansible_port=$port")
                fi
                if [[ -n "$identity" ]]; then
                    identity="$(canonical_file "$identity")" || { err "identity not found: $identity"; return 1; }
                    command+=(--private-key "$identity" --extra-vars "ansible_ssh_private_key_file=$identity")
                fi
                target_description="$target_description via $host"
                [[ -z "$user" ]] || target_description="$target_description as $user"
                [[ -z "$port" ]] || target_description="$target_description:$port"
            fi
            ;;
        host)
            validate_host "$host" || { err "invalid SSH host: $host"; return 2; }
            command+=(--inventory "$host,")
            if [[ -n "$user" ]]; then
                command+=(--user "$user")
            fi
            if [[ -n "$port" ]]; then
                validate_port "$port" || { err "port must be between 1 and 65535"; return 2; }
                command+=(--extra-vars "ansible_port=$port")
            fi
            if [[ -n "$identity" ]]; then
                identity="$(canonical_file "$identity")" || { err "identity not found: $identity"; return 1; }
                command+=(--private-key "$identity")
            fi
            target_description="$host"
            [[ -z "$user" ]] || target_description="$user@$target_description"
            [[ -z "$port" ]] || target_description="$target_description:$port"
            ;;
    esac

    if [[ "$target_mode" != local ]]; then
        if [[ "$ssh_plan" == true || "$ssh_preflight" == true || "$interactive" == true ]]; then
            need_ssh=true
        elif [[ "$action" == apply ]] && interactive_terminal_available; then
            need_ssh=true
        fi
    fi
    if [[ "$need_ssh" == true ]]; then
        if [[ "$target_mode" == host ]]; then
            inventory_host="$host"
            ssh_endpoint="$host"
            ssh_user="$user"
            ssh_port="$port"
            ssh_identity="$identity"
        else
            ssh_record=()
            while IFS= read -r line; do
                ssh_record+=("$line")
            done < <(inventory_ssh_record "$inventory" "${limit:-all}" "$vault_file" "$ask_vault")
            if [[ "${#ssh_record[@]}" -lt 6 || "${ssh_record[${#ssh_record[@]}-1]:-}" != MACHSTRAP_SSH_RECORD ]]; then
                if [[ "$ssh_plan" == true || "$ssh_preflight" == true || "$interactive" == true ]]; then
                    err "SSH interaction requires an inventory selection resolving to exactly one host"
                    return 2
                fi
                need_ssh=false
            else
                inventory_host="${ssh_record[0]}"
                ssh_endpoint="${ssh_record[1]}"
                ssh_user="${ssh_record[2]}"
                ssh_port="${ssh_record[3]}"
                ssh_identity="${ssh_record[4]}"
                for (( record_index=5; record_index<${#ssh_record[@]}-1; record_index++ )); do
                    case "${ssh_record[$record_index]}" in
                        ARG:*) ssh_inventory_args+=("${ssh_record[$record_index]#ARG:}") ;;
                        UNRESOLVED:*) ssh_unresolved="${ssh_record[$record_index]#UNRESOLVED:}" ;;
                        *)
                            err "inventory SSH arguments could not be parsed safely"
                            return 2
                            ;;
                    esac
                done
                if [[ -n "$host" ]]; then
                    ssh_endpoint="$host"
                    [[ -z "$user" ]] || ssh_user="$user"
                    [[ -z "$port" ]] || ssh_port="$port"
                    [[ -z "$identity" ]] || ssh_identity="$identity"
                fi
                if [[ -n "$ssh_unresolved" ]]; then
                    if [[ "$ssh_plan" == true || "$ssh_preflight" == true || "$interactive" == true ]]; then
                        err "cannot resolve $ssh_unresolved for $inventory_host: the value still contains a Jinja expression"
                        err "use concrete inventory SSH arguments or pass the OpenSSH file with --ssh-config"
                        return 2
                    fi
                    warn "skipping automatic SSH handshake for $inventory_host: $ssh_unresolved requires Ansible templating"
                    need_ssh=false
                fi
            fi
        fi
    fi
    if [[ "$need_ssh" == true ]]; then
        resolved_ssh_plan \
            "$inventory_host" "$ssh_endpoint" "$ssh_user" "$ssh_port" \
            "$ssh_identity" "$ssh_config" "$ssh_plan" || return 2
        [[ "$ssh_plan" != true ]] || return 0
        run_ssh_handshake "$ssh_preflight" || return $?
        [[ "$ssh_preflight" != true ]] || return 0
    fi

    [[ "$check" == true ]] && command+=(--check)
    [[ "$diff" == true ]] && command+=(--diff)
    command+=(--extra-vars "machstrap_interactive=$interactive")
    command+=(--extra-vars "machstrap_prompt_available=$prompt_available")
    [[ "$ask_pass" == true ]] && command+=(--ask-pass)
    [[ "$ask_become" == true ]] && command+=(--ask-become-pass)
    [[ "$ask_vault" == true ]] && command+=(--ask-vault-pass)
    [[ -z "$vault_file" ]] || command+=(--vault-password-file "$vault_file")
    [[ -n "$tags" ]] && command+=(--tags "$tags")
    [[ -n "$skip_tags" ]] && command+=(--skip-tags "$skip_tags")
    [[ -n "$verbosity" ]] && command+=("$verbosity")

    export ANSIBLE_CONFIG="$RUNTIME_ROOT/ansible.cfg"
    export ANSIBLE_ROLES_PATH="$RUNTIME_ROOT/roles"
    if [[ -z "${ANSIBLE_LOCAL_TEMP:-}" ]]; then
        ANSIBLE_TMP_OWNED="$(mktemp -d "${TMPDIR:-/tmp}/machstrap-ansible.XXXXXX")"
        chmod 700 "$ANSIBLE_TMP_OWNED"
        export ANSIBLE_LOCAL_TEMP="$ANSIBLE_TMP_OWNED"
    fi
    mode=APPLY
    [[ "$action" != check ]] || mode=VALIDATE
    [[ "$check" != true ]] || mode="DRY RUN"
    REPORT_TMP="$(mktemp "${TMPDIR:-/tmp}/machstrap-report.XXXXXX")"
    chmod 600 "$REPORT_TMP"
    started=$SECONDS
    set +e
    if [[ "$action" == check ]]; then
        ANSIBLE_DISPLAY_SKIPPED_HOSTS=True "${command[@]}" 2>&1 | tee "$REPORT_TMP"
    else
        "${command[@]}" 2>&1 | tee "$REPORT_TMP"
    fi
    ansible_status=${PIPESTATUS[0]}
    set -e
    if [[ "$ansible_status" -eq 0 ]] && grep -qx 'skipping: no hosts matched' "$REPORT_TMP"; then
        err "target selection matched no hosts: $target_description"
        ansible_status=2
    fi
    render_run_report "$REPORT_TMP" "$ansible_status" "$mode" "$profile" "$target_description" "$((SECONDS - started))"
    rm -f -- "$REPORT_TMP"
    REPORT_TMP=""
    return "$ansible_status"
}

main() {
    local command="${1:-}"
    [[ -n "$command" ]] || { usage; return 2; }
    shift
    case "$command" in
        --version) [[ $# -eq 0 ]] || { err "--version accepts no arguments"; return 2; }; version_command ;;
        doctor) [[ $# -eq 0 ]] || { err "doctor accepts no arguments"; return 2; }; doctor ;;
        update|upgrade) update_command "$@" ;;
        config) config_command "$@" ;;
        profiles) profiles_command "$@" ;;
        inventories) inventories_command "$@" ;;
        identities) identities_command "$@" ;;
        bundle) bundle_create "$@" ;;
        check|apply)
            if (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; then
                run_usage "$command"
                return
            fi
            [[ $# -ge 1 ]] || { err "$command requires a profile or bundle"; return 2; }
            local profile="$1"
            shift
            run_ansible "$command" "$profile" "$@"
            ;;
        help|-h|--help) usage ;;
        *) err "unknown command: $command"; usage >&2; return 2 ;;
    esac
}

main "$@"
